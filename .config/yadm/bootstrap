#!/usr/bin/env bash
set -euo pipefail

# 分岐で使うプラットフォームを最初に判定する。
system_type=$(uname -s)
profile_file="$HOME/.zprofile"
homebrew_brew_remote="${HOMEBREW_BREW_GIT_REMOTE:-https://github.com/Homebrew/brew}"
homebrew_core_remote="${HOMEBREW_CORE_GIT_REMOTE:-https://github.com/Homebrew/homebrew-core}"
if [ "$system_type" = "Linux" ]; then
  case "$homebrew_brew_remote" in
    git@github.com:Homebrew/brew|ssh://git@github.com/Homebrew/brew)
      homebrew_brew_remote="https://github.com/Homebrew/brew"
      ;;
  esac
  case "$homebrew_core_remote" in
    git@github.com:Homebrew/homebrew-core|ssh://git@github.com/Homebrew/homebrew-core)
      homebrew_core_remote="https://github.com/Homebrew/homebrew-core"
      ;;
  esac
fi
export HOMEBREW_BREW_GIT_REMOTE="$homebrew_brew_remote"
export HOMEBREW_CORE_GIT_REMOTE="$homebrew_core_remote"

run_with_homebrew_git_config() {
  GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_COUNT=2 \
    GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf \
    GIT_CONFIG_VALUE_0=git@github.com: \
    GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf \
    GIT_CONFIG_VALUE_1=ssh://git@github.com/ \
    "$@"
}

fix_homebrew_remote() {
  for homebrew_repo in \
    /opt/homebrew/Homebrew \
    /usr/local/Homebrew \
    /home/linuxbrew/.linuxbrew/Homebrew \
    "$HOME/.linuxbrew/Homebrew"; do
    if [ -e "$homebrew_repo/.git" ]; then
      if ! run_with_homebrew_git_config git -C "$homebrew_repo" remote set-url origin "$homebrew_brew_remote" 2>/dev/null; then
        if command -v sudo >/dev/null 2>&1; then
          sudo git -C "$homebrew_repo" remote set-url origin "$homebrew_brew_remote" 2>/dev/null || true
        fi
      fi
    fi
  done
}

gitconfig_backup=""
restore_gitconfig() {
  if [ -n "$gitconfig_backup" ] && [ -f "$gitconfig_backup" ]; then
    cp "$gitconfig_backup" "$HOME/.gitconfig"
    rm -f "$gitconfig_backup"
  fi
}

disable_github_ssh_rewrite_on_linux() {
  if [ "$system_type" != "Linux" ] || ! command -v git >/dev/null 2>&1; then
    return 0
  fi

  if git config --global --get-all 'url.git@github.com:.insteadOf' >/dev/null 2>&1 || \
    git config --global --get-all 'url.ssh://git@github.com/.insteadOf' >/dev/null 2>&1; then
    gitconfig_backup=$(mktemp)
    cp "$HOME/.gitconfig" "$gitconfig_backup"
    trap restore_gitconfig EXIT
    git config --global --unset-all 'url.git@github.com:.insteadOf' || true
    git config --global --unset-all 'url.ssh://git@github.com/.insteadOf' || true
  fi
}

# Ubuntu/Debian では必須パッケージをインストールする。
if [ "$system_type" = "Linux" ]; then
  echo "[Step] Linux の基本パッケージを更新しています"
  sudo apt update
  sudo apt install -y zsh git curl wget ca-certificates gnupg build-essential locales unzip tar gzip
  sudo locale-gen ja_JP.UTF-8
fi

# Homebrew/Linuxbrew がなければインストールする。
if ! command -v brew >/dev/null 2>&1; then
  echo "[Step] Homebrew をインストールしています"
  disable_github_ssh_rewrite_on_linux
  fix_homebrew_remote
  NONINTERACTIVE=1 \
    HOMEBREW_BREW_GIT_REMOTE="$homebrew_brew_remote" \
    HOMEBREW_CORE_GIT_REMOTE="$homebrew_core_remote" \
    run_with_homebrew_git_config /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fix_homebrew_remote
fi

# brew のインストール先 prefix を判定する。
if command -v brew >/dev/null 2>&1; then
  brew_bin=$(command -v brew)
elif [ -x /opt/homebrew/bin/brew ]; then
  brew_bin="/opt/homebrew/bin/brew"
elif [ -x /usr/local/bin/brew ]; then
  brew_bin="/usr/local/bin/brew"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  brew_bin="/home/linuxbrew/.linuxbrew/bin/brew"
elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
  brew_bin="$HOME/.linuxbrew/bin/brew"
else
  echo "[Error] インストール後に brew コマンドが見つかりません"
  exit 1
fi
brew_prefix=$("$brew_bin" --prefix)

# 現在のシェルに brew の環境変数を読み込む。
eval "$(${brew_prefix}/bin/brew shellenv)"

# ログインシェルでも自動で読み込まれるように PATH 設定を保存する。
touch "$profile_file"
if ! grep -qxF "eval \"\$(${brew_prefix}/bin/brew shellenv)\"" "$profile_file"; then
  echo "eval \"\$(${brew_prefix}/bin/brew shellenv)\"" >> "$profile_file"
fi

# 必要に応じてデフォルトシェルを zsh に切り替える。
if command -v zsh >/dev/null 2>&1; then
  if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
    if ! chsh -s "$(command -v zsh)"; then
      echo "[Warn] chsh に失敗しました（パスワード入力が必要な場合があります）"
    fi
  fi
else
  echo "[Warn] zsh コマンドが見つからないため chsh をスキップします"
fi

# Brewfile に定義されたパッケージをインストールする。
repo=""
if command -v yadm >/dev/null 2>&1; then
  if ! repo=$(yadm rev-parse --show-toplevel 2>/dev/null); then
    repo=""
  fi
fi

if [ -z "$repo" ]; then
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  repo=$(cd "${script_dir}/../.." && pwd)
  echo "[Warn] yadm でリポジトリを特定できないため ${repo} を使用します"
fi
cd "$repo"

brewfile="$repo/.homebrew/Brewfile"
if [ -f "$brewfile" ]; then
  echo "[Step] brew bundle を実行しています"
  run_with_homebrew_git_config brew bundle --file "$brewfile"
else
  echo "[Info] $brewfile が見つかりません"
fi
