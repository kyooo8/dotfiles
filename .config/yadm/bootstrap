#!/usr/bin/env bash
set -euo pipefail

# 分岐で使うプラットフォームを最初に判定する。
system_type=$(uname -s)
profile_file="$HOME/.zprofile"
homebrew_brew_remote="${HOMEBREW_BREW_GIT_REMOTE:-https://github.com/Homebrew/brew}"
homebrew_core_remote="${HOMEBREW_CORE_GIT_REMOTE:-https://github.com/Homebrew/homebrew-core}"
export HOMEBREW_BREW_GIT_REMOTE="$homebrew_brew_remote"
export HOMEBREW_CORE_GIT_REMOTE="$homebrew_core_remote"

fix_homebrew_remote() {
  for homebrew_repo in \
    /opt/homebrew/Homebrew \
    /usr/local/Homebrew \
    /home/linuxbrew/.linuxbrew/Homebrew \
    "$HOME/.linuxbrew/Homebrew"; do
    if [ -d "$homebrew_repo/.git" ]; then
      GIT_CONFIG_GLOBAL=/dev/null git -C "$homebrew_repo" remote set-url origin "$homebrew_brew_remote" 2>/dev/null || true
    fi
  done
}

# Ubuntu/Debian では必須パッケージをインストールする。
if [ "$system_type" = "Linux" ]; then
  echo "[Step] Linux の基本パッケージを更新しています"
  sudo apt update
  sudo apt install -y zsh git curl wget ca-certificates gnupg build-essential locales unzip tar gzip
  sudo locale-gen ja_JP.UTF-8
fi

# Homebrew/Linuxbrew がなければインストールする。
if ! command -v brew >/dev/null 2>&1; then
  echo "[Step] Homebrew をインストールしています"
  fix_homebrew_remote
  NONINTERACTIVE=1 GIT_CONFIG_GLOBAL=/dev/null /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# brew のインストール先 prefix を判定する。
if command -v brew >/dev/null 2>&1; then
  brew_bin=$(command -v brew)
elif [ -x /opt/homebrew/bin/brew ]; then
  brew_bin="/opt/homebrew/bin/brew"
elif [ -x /usr/local/bin/brew ]; then
  brew_bin="/usr/local/bin/brew"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  brew_bin="/home/linuxbrew/.linuxbrew/bin/brew"
elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
  brew_bin="$HOME/.linuxbrew/bin/brew"
else
  echo "[Error] インストール後に brew コマンドが見つかりません"
  exit 1
fi
brew_prefix=$("$brew_bin" --prefix)

# 現在のシェルに brew の環境変数を読み込む。
eval "$(${brew_prefix}/bin/brew shellenv)"

# ログインシェルでも自動で読み込まれるように PATH 設定を保存する。
touch "$profile_file"
if ! grep -qxF "eval \"\$(${brew_prefix}/bin/brew shellenv)\"" "$profile_file"; then
  echo "eval \"\$(${brew_prefix}/bin/brew shellenv)\"" >> "$profile_file"
fi

# 必要に応じてデフォルトシェルを zsh に切り替える。
if command -v zsh >/dev/null 2>&1; then
  if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
    if ! chsh -s "$(command -v zsh)"; then
      echo "[Warn] chsh に失敗しました（パスワード入力が必要な場合があります）"
    fi
  fi
else
  echo "[Warn] zsh コマンドが見つからないため chsh をスキップします"
fi

# Brewfile に定義されたパッケージをインストールする。
repo=""
if command -v yadm >/dev/null 2>&1; then
  if ! repo=$(yadm rev-parse --show-toplevel 2>/dev/null); then
    repo=""
  fi
fi

if [ -z "$repo" ]; then
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  repo=$(cd "${script_dir}/../.." && pwd)
  echo "[Warn] yadm でリポジトリを特定できないため ${repo} を使用します"
fi
cd "$repo"

if [ -f "$repo/Brewfile" ]; then
  echo "[Step] brew bundle を実行しています"
  GIT_CONFIG_GLOBAL=/dev/null brew bundle --file "$repo/Brewfile"
else
  echo "[Info] $repo に Brewfile が見つかりません"
fi
