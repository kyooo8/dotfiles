#!/usr/bin/env bash
set -euo pipefail

AGENTS_DIR="$HOME/dev/.worktrees"

usage() {
  cat <<EOF
Usage: wt hi <branch>            create/switch a worktree for this branch
       wt <name-or-branch>         move to this repository's worktree (requires shell-init)
       wt                          pick a worktree interactively (requires shell-init)
       wt bye <name-or-branch|.>   remove a worktree (. = current worktree)
       wt list                     show status of all worktrees
       wt shell-init               print shell integration for bash/zsh
EOF
}

worktree_dirs() {
  local dir
  for dir in "$AGENTS_DIR"/*/ "$AGENTS_DIR"/*/*/; do
    [ -e "${dir%/}/.git" ] || continue
    printf '%s\0' "${dir%/}"
  done
}

resolve_agent_dir() {
  local identifier="$1"
  local repo_common="${2:-}"
  local matches=()
  local dir branch target_common
  while IFS= read -r -d '' dir; do
    if [ -n "$repo_common" ]; then
      target_common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir) || continue
      [ "$repo_common" = "$target_common" ] || continue
    fi
    branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "")
    if [ "${dir#"$AGENTS_DIR/"}" = "$identifier" ] ||
       [ "${dir##*/}" = "$identifier" ] || [ "$branch" = "$identifier" ]; then
      matches+=("$dir")
    fi
  done < <(worktree_dirs)

  if [ "${#matches[@]}" -eq 0 ]; then
    echo "ERROR: no agent or branch matching '$identifier'" >&2
    return 1
  elif [ "${#matches[@]}" -gt 1 ]; then
    echo "ERROR: branch '$identifier' matches multiple agents: ${matches[*]}" >&2
    return 1
  fi
  echo "${matches[0]}"
}

remove_worktree() {
  local target="$1"
  local name="$2"

  check_clean_and_pushed "$target" "$name"
  local workspace_id
  workspace_id=$(herdr worktree list --cwd "$target" | jq -r --arg path "$target" '.result.worktrees[] | select(.path == $path) | .open_workspace_id // empty')
  if [ -n "$workspace_id" ]; then
    herdr worktree remove --workspace "$workspace_id"
  else
    git -C "$target" worktree remove "$target"
  fi
}

check_clean_and_pushed() {
  local dir="$1"
  local name="$2"

  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    echo "ERROR: agent '$name' has uncommitted changes. Refusing to remove." >&2
    git -C "$dir" status --short >&2
    exit 1
  fi

  local branch
  branch=$(git -C "$dir" branch --show-current)

  if ! git -C "$dir" rev-parse --abbrev-ref "${branch}@{upstream}" >/dev/null 2>&1; then
    if [ -n "$(git -C "$dir" for-each-ref --contains=HEAD --format='%(refname)' refs/remotes)" ]; then
      return 0
    fi
    if [ "$(git -C "$dir" for-each-ref --format='%(upstream:track)' "refs/heads/$branch")" = "[gone]" ]; then
      return 0
    fi
    echo "ERROR: agent '$name' branch '$branch' has no upstream and HEAD is not contained in any remote-tracking branch. Refusing to remove." >&2
    exit 1
  fi

  local unpushed
  unpushed=$(git -C "$dir" log "@{upstream}..HEAD" --oneline)
  if [ -n "$unpushed" ]; then
    echo "ERROR: agent '$name' has unpushed commits on '$branch'. Refusing to remove." >&2
    echo "$unpushed" >&2
    exit 1
  fi
}

cmd_hi() {
  local branch="${1:-}"
  [ -n "$branch" ] || { usage >&2; exit 1; }

  local repo_root
  repo_root=$(git rev-parse --show-toplevel)
  local reponame
  reponame=$(basename "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")")
  git check-ref-format --branch "$branch" >/dev/null
  local name="${branch//\//_}"
  local target="$AGENTS_DIR/$reponame/$name"
  if [ -d "$target" ] && [ "$(git -C "$target" branch --show-current)" != "$branch" ]; then
    echo "ERROR: '$target' already exists for a different branch. Refusing to replace." >&2
    exit 1
  fi

  local remote_ref
  remote_ref=$(git -C "$repo_root" for-each-ref --format='%(refname)' "refs/remotes/*/$branch" | head -1)
  if [ -n "$remote_ref" ]; then
    if ! git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_root" branch "$branch" "$remote_ref"
    elif git -C "$repo_root" merge-base --is-ancestor "refs/heads/$branch" "$remote_ref"; then
      git -C "$repo_root" branch -f "$branch" "$remote_ref"
    else
      echo "ERROR: local branch '$branch' has diverged from '$remote_ref'. Refusing to create a worktree with stale content." >&2
      echo "       fix with: git -C '$repo_root' branch -f '$branch' '$remote_ref'" >&2
      exit 1
    fi
  fi

  mkdir -p "$AGENTS_DIR/$reponame"
  [ -d "$target" ] && remove_worktree "$target" "$name"

  herdr worktree create --branch "$branch" --cwd "$repo_root" --path "$target" --label "$name"

  # .claude/settings.local.json はコピー不要。Claude Codeはworktreeでもメインチェックアウトの
  # ルートにあるファイルを自動的に読み書きする(公式ドキュメントで確認済み)。
  [ -f "$repo_root/mise.toml" ] && cp "$repo_root/mise.toml" "$target/mise.toml"

  echo "Ready: $target"
}

cmd_bye() {
  local identifier="${1:-}"
  [ -n "$identifier" ] || { usage >&2; exit 1; }

  local target
  if [ "$identifier" = . ]; then
    target=$(git rev-parse --show-toplevel) || return 1
    if [ ! -f "$target/.git" ]; then
      echo "ERROR: current directory is not a linked worktree. Refusing to remove." >&2
      return 1
    fi
  else
    target=$(resolve_agent_dir "$identifier") || return 1
  fi
  local name
  name=$(basename "$target")

  remove_worktree "$target" "$name"
  echo "Removed: $target"
}

agent_status_line() {
  local dir="$1"
  local name
  name=$(basename "$dir")
  local repo branch status
  repo=$(basename "$(dirname "$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null)")" 2>/dev/null || echo "?")
  branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "?")
  status=""
  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    status="${status} [uncommitted]"
  fi
  if git -C "$dir" rev-parse --abbrev-ref "${branch}@{upstream}" >/dev/null 2>&1; then
    local unpushed_count
    unpushed_count=$(git -C "$dir" log "@{upstream}..HEAD" --oneline 2>/dev/null | wc -l | tr -d ' ')
    [ "$unpushed_count" != "0" ] && status="${status} [unpushed:${unpushed_count}]"
  else
    status="${status} [no upstream]"
  fi
  echo "${name}: ${repo} @ ${branch}${status}"
}

cmd_list() {
  [ -d "$AGENTS_DIR" ] || { echo "No agents yet."; return; }
  while IFS= read -r -d '' dir; do
    agent_status_line "$dir"
  done < <(worktree_dirs)
}

cmd_pick() {
  [ -d "$AGENTS_DIR" ] || { echo "No agents yet." >&2; return 1; }
  local dirs=() lines=()
  while IFS= read -r -d '' dir; do
    dirs+=("${dir%/}")
    lines+=("$(agent_status_line "$dir")")
  done < <(worktree_dirs)
  [ "${#dirs[@]}" -gt 0 ] || { echo "No agents yet." >&2; return 1; }

  local PS3="wt> "
  select _ in "${lines[@]}"; do
    [ -n "${REPLY:-}" ] && [ "$REPLY" -ge 1 ] 2>/dev/null && [ "$REPLY" -le "${#dirs[@]}" ] || continue
    printf '%s\n' "${dirs[$((REPLY - 1))]}"
    return 0
  done < /dev/tty
}

cmd_path() {
  [ "$#" -eq 1 ] || { usage >&2; exit 1; }
  local target repo_common
  repo_common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
  target=$(resolve_agent_dir "$1" "$repo_common") || return 1
  printf '%s\n' "$target"
}

cmd_shell_init() {
  cat <<'EOF'
wt() {
  case "${1:-}" in
    bye)
      if [ "${2:-}" = . ]; then
        local repo_root
        repo_root=$(git rev-parse --path-format=absolute --git-common-dir) || return
        repo_root=$(dirname "$repo_root")
        command wt "$@" || return
        cd -- "$repo_root"
      else
        command wt "$@"
      fi
      ;;
    hi|list|shell-init|-h|--help|help) command wt "$@" ;;
    '')
      local target
      target=$(command wt pick) || return
      cd -- "$target"
      ;;
    *)
      local target
      target=$(command wt "$@") || return
      cd -- "$target"
      ;;
  esac
}
EOF
}

case "${1:-}" in
  hi) shift; cmd_hi "$@" ;;
  bye) shift; cmd_bye "$@" ;;
  list) cmd_list ;;
  pick) cmd_pick ;;
  shell-init) cmd_shell_init ;;
  -h|--help|help) usage ;;
  *) cmd_path "$@" ;;
esac
