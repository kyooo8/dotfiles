{
  "title": "Hyper Simple Vim Layer",
  "rules": [
    {
      "description": "Hyper + hjkl = arrows, a = ctrl+a, e = ctrl+e, space = toggle Japanese/English",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "japanese_eisuu" }],
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [{ "language": "^ja$" }]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "japanese_kana" }],
          "conditions": [
            {
              "type": "input_source_unless",
              "input_sources": [{ "language": "^ja$" }]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "a", "modifiers": ["control"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "e",
            "modifiers": { "mandatory": ["command", "control", "option"] }
          },
          "to": [{ "key_code": "e", "modifiers": ["control"] }]
        }
      ]
    }
  ]
}
