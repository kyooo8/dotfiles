[include]
  path = ~/.config/vendor/catppuccin-delta/catppuccin.gitconfig
  path = ~/.gitconfig.local

[core]
  pager = delta
  excludesFile = ~/.config/git/ignore

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  features = catppuccin-macchiato

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[ghq]
  root = ~/dev

[url "git@github.com:"]
  insteadOf = https://github.com/
